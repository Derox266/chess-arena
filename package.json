{
  "name": "chess-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nowoczesna przeglądarkowa arena szachowa ze Stockfish 19",
  "scripts": {
    "postinstall": "node scripts/copy-engine.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/copy-engine.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {"node": ">=22.12.0"}
}
